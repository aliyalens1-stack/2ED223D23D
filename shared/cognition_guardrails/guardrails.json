  "required_vocabulary": {
    "$comment": "Phrases that MUST appear in each surface's source. These anchor the restrained doctrine — their presence is the structural marker that the surface speaks the continuity vocabulary.",

    "intake": [
      "Establish inspection context",
      "Information may still be added later",
      "Vehicle reference",
      "Scheduling window"
    ],
    "establishment": [
      "Inspection context established",
      "Context recorded",
      "References"
    ],
    "continuity": [
      "Inspection continuity",
      "Forming",
      "Accumulating",
      "Established",
      "Delivered"
    ],
    "cognition": [
      "Refresh interpretation",
      "structurally_matters",
      "remains_uncertain",
      "supports_interpretation",
      "may_require_review"
    ]
  },

  "structural_invariants": {
    "$comment": "Declarative assertions about DOM presence/absence in specific app states. The runner takes a state (e.g. {auth: customer, location: '/dashboard/request/new'}) and verifies these invariants. `present` = count >= 1, `absent` = count == 0. The doctrine of structural absence — pre-engagement bridges must NOT exist in DOM (no disabled state, no 'coming soon').",

    "intake_initial": {
      "url_pattern": "/dashboard/request/new",
      "present": [
        "request-intake-page",
        "intake-title",
        "intake-section-vehicle",
        "intake-section-location",
        "intake-section-scheduling",
        "intake-incompleteness-note",
        "intake-establish-btn"
      ],
      "absent": []
    },

    "establishment_pre_engagement": {
      "$comment": "After intake POST. Inspector has NOT engaged on any job yet. Continuity bridge must be structurally absent.",
      "url_pattern": "/dashboard/request/:id/establishment",
      "present": [
        "request-establishment-page",
        "establishment-title",
        "establishment-state",
        "establishment-vehicle",
        "establishment-location",
        "establishment-references",
        "establishment-request-detail-link",
        "establishment-requests-list-link"
      ],
      "absent": [
        "establishment-continuity-bridge",
        "establishment-continuity-link"
      ]
    },

    "cognition_forming": {
      "$comment": "Pre-delivery cognition. Single forming line; 4-section document MUST be structurally absent (count == 0). No skeleton DOM.",
      "url_pattern": "/dashboard/inspection/:jobId/report-cognition",
      "state": "forming",
      "present": [
        "report-cognition-page",
        "cognition-forming-state"
      ],
      "absent": [
        "cognition-document",
        "cognition-structurally-matters",
        "cognition-remains-uncertain",
        "cognition-supports-interpretation",
        "cognition-may-require-review"
      ]
    },

    "continuity_forming": {
      "$comment": "Pre-delivery continuity. Cognition bridge link must be absent.",
      "url_pattern": "/dashboard/inspection/:jobId/continuity",
      "state": "forming|accumulating|established",
      "present": [
        "inspection-continuity-page",
        "continuity-state",
        "continuity-interpretation"
      ],
      "absent": [
        "continuity-cognition-bridge",
        "continuity-cognition-link"
      ]
    }
  },

  "surface_source_paths": {
    "$comment": "File globs that the static scanner walks. Each surface lists its source files + which forbidden/required groups apply.",

    "intake_web": {
