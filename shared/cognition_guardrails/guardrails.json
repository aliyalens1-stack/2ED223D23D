      "expert-approved",
      "expert approved",
      "green light",
      "red flag",
      "yellow flag",
      "view ai report",
      "open analysis",
      "confidence summary"
    ],

    "operational_leak": [
      "draft",
      "flagged",
      "queue",
      "queued",
      "system",
      "internal",
      "operational",
      "telemetry",
      "diagnostic"
    ],

    "urgency_theatre": [
      "urgent",
      "urgency",
      "act now",
      "limited time",
