    ]
  },

  "forbidden_colors": {
    "$comment": "Red palette is reserved for SYSTEM errors only. Customer-facing rejection / verification / continuity surfaces must use amber (warning) tones. These hex literals must not appear in customer-area surface source after the Step 3 cleanup.",
    "red_rejection": [
      "#7f1d1d",
      "#2a1010",
      "#fecaca",
      "#fda4af",
