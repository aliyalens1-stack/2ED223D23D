tle\": \"Änderungen der Bedingungen\"\n      },\n      \"contact\": {\n        \"body\": \"Rechtliches: legal@auto-search.app · Support: support@auto-search.app · Geschäftsadresse: im Bereich „Über uns\\\" der App.\",\n        \"title\": \"Kontakt\"\n      },\n      \"data_privacy\": {\n        \"body\": \"Wir erfassen nur Daten, die für die Leistung nötig sind: Kontakte, Suchkriterien, Berichte, Zahlungs-Token (nicht die Kartendaten selbst). Keine Weitergabe an Dritte außer bei gesetzlicher Pflicht. Details in unserer Datenschutzerklärung.\",\n        \"title\": \"Daten & Datenschutz\"\n      },\n      \"disputes\": {\n        \"body\": \"Bei Uneinigkeit mit dem Bericht haben Sie 72 Stunden Zeit für eine Reklamation. Es erfolgt eine unabhängige Nachprüfung. Bei bestätigter Abweichung — volle Rückerstattung + 50 % Entschädigung. Reklamationen müssen über die App eröffnet werden.\",\n        \"title\": \"Reklamationen & Erstattung\"\n      },\n      \"governing_law\": {\n        \"body\": \"Es gilt deutsches Recht (für die EU-Region) oder zwingendes Verbraucherrecht des Wohnsitzlandes des Nutzers, soweit anwendbar. Gerichtsstand ist der Wohnsitz des Nutzers.\",\n        \"title\": \"Anwendbares Recht\"\n      },\n      \"inspector_role\": {\n        \"body\": \"Prüfer und Suchspezialisten sind unabhängige Auftragnehmer. Sie haften für die Qualität ihrer Arbeit gemäß professionellen Standards. Auto Search prüft Dokumente, Erfahrung und Versicherung, ist aber nicht Arbeitgeber.\",\n        \"title\": \"Rolle der Prüfer und Spezialisten\"\n      },\n      \"liability\": {\n        \"body\": \"Auto Search agiert als Marktplatz. Wir haften nicht direkt für den Fahrzeugzustand oder Ihre Kaufentscheidung. Unsere Haftung ist auf den Preis der bezahlten Dienstleistungen begrenzt. Bei versteckten, durch den Prüfer übersehenen Mängeln gilt das Reklamationsverfahren (Abschnitt 9).\",\n        \"title\": \"Haftung\"\n      },\n      \"payments\": {\n        \"body\": \"Alle Zahlu