n    \"year_to\": \"Jahr bis\"\n  },\n  \"garage\": {\n    \"add_btn\": \"Auto hinzufügen\",\n    \"add_modal_title\": \"Auto hinzufügen\",\n    \"auth_btn\": \"Anmelden\",\n    \"auth_title\": \"Anmelden für Garagen-Zugang\",\n    \"brand_label\": \"Marke *\",\n    \"brand_placeholder\": \"z.B. BMW\",\n    \"delete_body\": \"Kann nicht rückgängig gemacht werden\",\n    \"delete_cancel\": \"Abbrechen\",\n    \"delete_confirm\": \"Löschen\",\n    \"delete_title\": \"Auto löschen?\",\n    \"empty_text\": \"Fügen Sie Ihr Auto hinzu für schnelle Werkstattsuche\",\n    \"empty_title\": \"Garage ist leer\",\n    \"error_add\": \"Konnte Auto nicht hinzufügen\",\n    \"error_brand_model\": \"Marke und Modell angeben\",\n    \"error_delete\": \"Konnte Auto nicht löschen\",\n    \"model_label\": \"Modell *\",\n    \"model_placeholder\": \"z.B. X5\",\n    \"save_btn\": \"Hinzufügen\",\n    \"title\": \"Meine Garage\",\n    \"vehicle_year\": \"{{year}}\",\n    \"vin_label\": \"FIN\",\n    \"vin_placeholder\": \"FIN-Nummer\",\n    \"vin_prefix\": \"FIN: {{vin}}\",\n    \"year_label\": \"Baujahr\",\n    \"year_placeholder\": \"2020\"\n  },\n  \"help\": {\n    \"cat\": {\n      \"inspection\": {\n        \"duration\": {\n          \"a\": \"60–90 Minuten vor Ort. Der vollständige Bericht mit Foto- und Video-Belegen erscheint innerhalb 24 Stunden nach dem Termin in der App.\",\n          \"q\": \"Wie lange dauert es?\"\n        },\n        \"how_it_works\": {\n          \"a\": \"Ein zertifizierter Prüfer kommt zum Fahrzeug und führt eine 60-Punkte-Prüfung durch: Motor, Fahrwerk, Karosserie, Elektrik, Unfallhistorie, Lackdicke jeder Karosserieseite, OBD-II-Diagnose. Jeder Mangel wird fotografiert. Bericht innerhalb 24 Stunden in der App.\",\n          \"q\": \"Wie läuft die Prüfung ab?\"\n        },\n        \"inspectors\": {\n          \"a\": \"Ausschließlich zertifizierte Fachleute mit mindestens 5 Jahren Erfahrung. Alle durchlaufen Dokumentenprüfung, besitzen Fachausbildung (TÜV / DEKRA o.ä.) und Berufshaftpflicht. Sie sehen Bewertung und echte Kundenrezensionen.\",\n          \"q\": \"Wer sind die Prüfer?\"\n        },\n        \"title\": \"Fahrzeugprüfung (TÜV-Stil)\",\n        \"what_we_photograph\": {\n          \"a\": \"VIN, Kilometerstand, Karosserie aus 8 Perspektiven, Lackdicke pro Seite, Reifen, Felgen, Bremsen, Fahrwerk, Motorraum, Innenraum, OBD-II-Bildschirm mit Codes. Jedes Foto ist zeit- und ortsgestempelt.\",\n          \"q\": \"Was wird fotografiert?\"\n        },\n        \"whats_in_report\": {\n          \"a\": \"Bewertung 0–10, Empfehlung (empfohlen / bedingt / nicht empfohlen), Liste kritischer und unkritischer Mängel, Reparaturkostenschätzung, Fotos jedes Mangels, Motorlaufvideo und Verhandlungstipps für den Verkäufer.\",\n          \"q\": \"Was steht im Bericht?\"\n        }\n      },\n      \"pricing\": {\n        \"extra_fees\": {\n          \"a\": \"Die Standardprüfung umfasst die 60-Punkte-Prüfung. Zusatzleistungen (Prüfstand-Diagnose, Endoskop, Lacktester) erscheinen separat im Angebot. Ohne Ihre Zustimmung wird nichts berechnet.\",\n          \"q\": \"Gibt es Zusatzkosten?\"\n        },\n        \"how_price_formed\": {\n          \"a\": \"Fahrzeugsuche — feste monatliche Gebühr. Prüfung — Festpreis pro Termin, abhängig von Stadt und Fahrzeugtyp. Der Preis wird immer vor Bestätigung angezeigt. Keine versteckten Kosten.\",\n          \"q\": \"Wie wird der Preis gebildet?\"\n        },\n        \"payment_methods\": {\n          \"a\": \"Visa / Mastercard, Apple Pay, Google Pay, SEPA-Überweisung (EU). Alle Zahlungen über Stripe, einen sicheren Zahlungsdienstleister. Bar nehmen wir nicht an.\",\n          \"q\": \"Womit kann ich bezahlen?\"\n        },\n        \"title\": \"Preise & Zahlung\",\n        \"when_charged\": {\n          \"a\": \"Suche: bei Abo-Start. Prüfung: Beträge werden bei Bestätigung reserviert und erst nach Hochladen des Berichts an den Prüfer freigegeben. Bis dahin liegen sie sicher im Treuhand bei uns.\",\n          \"q\": \"Wann wird abgebucht?\"\n        }\n      },\n      \"safety\": {\n        \"data_privacy\": {\n          \"a\": \"Wir speichern nur, was für Suche und Prüfung nötig ist: Kontakte, Suchkriterien, Berichte. Keine Weitergabe an Dritte. Sie können Ihr Konto löschen — Daten werden binnen 30 Tagen entfernt (außer gesetzlich erforderliche Aufbewahrung).\",\n          \"q\": \"Was passiert mit meinen Daten?\"\n        },\n        \"dispute\": {\n          \"a\": \"Sie haben 72 Stunden für eine Reklamation. Eröffnen Sie sie im Anfrage-Chat → ein unabhängiger zweiter Prüfer überprüft die strittigen Punkte kostenlos. Bestätigt sich die Abweichung — volle Rückerstattung.\",\n          \"q\": \"Was tun bei Uneinigkeit mit dem Bericht?\"\n        },\n        \"guarantee\": {\n          \"a\": \"Die Richtigkeit des Berichts: tritt innerhalb von 30 Tagen nach Kauf ein versteckter Mangel auf, den der Prüfer hätte erkennen müssen — erstatten wir die Prüfgebühr und übernehmen einen Teil der Reparatur gemäß Vertragsbedingungen.\",\n          \"q\": \"Was garantieren Sie?\"\n        },\n        \"refund\": {\n          \"a\": \"Kommt die Prüfung durch unser Verschulden nicht zustande — volle Erstattung binnen 3 Werktagen auf dieselbe Karte. Bei Ihrer Stornierung nach Anreise des Prüfers — Anfahrtspauschale gemäß Stadttarif wird einbehalten.\",\n          \"q\": \"Wie funktioniert die Rückerstattung?\"\n        },\n        \"title\": \"Garantien & Sicherheit\"\n      },\n      \"selection\": {\n        \"agreement_flow\": {\n          \"a\": \"Ihr Spezialist sendet 1–3 Autos pro Tag in Ihren Anfrage-Chat. Jedes Angebot enthält Fotos, Preis, Kennzahlen und seine Bewertung. Wenn Sie zustimmen — vereinbaren wir die Besichtigung und schicken den Prüfer.\",\n          \"q\": \"Wie wird der Kandidat freigegeben?\"\n        },\n        \"duration_selection\": {\n          \"a\": \"Im Schnitt 3–10 Tage bis zum ersten Kandidaten, der unsere Filter besteht. Seltene Ausstattungen oder ungewöhnliche Modelle bis zu 4 Wochen. Den Fortschritt sehen Sie live in der App.\",\n          \"q\": \"Wie lange dauert die Suche?\"\n        },\n        \"how_we_find\": {\n          \"a\": \"Sie geben Ihre Kriterien an: Marke, Modell, Budget, Baujahr, Kilometerstand, Getriebe, Region. Unser Spezialist beobachtet die Marktplätze 24/7 und schickt Ihnen die Top 3 Kandidaten mit einer kurzen Einschätzung — was gut ist, was auffällt. Sie entscheiden, welcher weiterverfolgt wird.\",\n          \"q\": \"Wie funktioniert die Fahrzeugsuche?\"\n        },\n        \"pre_visit_checks\": {\n          \"a\": \"VIN-Historie (CarVertical-/Carfax-ähnlich), Kilometerstand-Abgleich mit Servicedaten, Verkäufertyp (privat / Wiederverkäufer / Händler), Preis im Marktvergleich, Foto-Analyse auf versteckte Mängel. Sieht etwas kritisch aus — wird das Inserat aussortiert.\",\n          \"q\": \"Was wird vor dem Prüfertermin geprüft?\"\n        },\n        \"sources\": {\n          \"a\": \"Deutschland: mobile.de, autoscout24, kleinanzeigen, Händler-Feeds. Österreich: autoscout24.at, willhaben.at. Außerdem private Inserate und geschlossene Händlernetzwerke unserer Partner.\",\n          \"q\": \"Wo wird gesucht?\"\n        },\n        \"title\": \"Fahrzeugsuche\"\n      },\n      \"support\": {\n        \"languages\": {\n          \"a\": \"Deutsch, Englisch, Russisch. App-Oberfläche und Prüfberichte sind ebenfalls in allen drei Sprachen verfügbar.\",\n          \"q\": \"In welchen Sprachen ist der Support?\"\n        },\n        \"response_time\": {\n          \"a\": \"Standard-Antwortzeit: unter 6 Stunden während der Geschäftszeiten (Mo–Sa 09:00–20:00 MEZ). Dringende Anliegen bei laufender Prüfung — bevorzugt, unter 1 Stunde.\",\n          \"q\": \"Wie schnell ist die Antwort?\"\n        },\n        \"title\": \"Support\",\n        \"where_chat\": {\n          \"a\": \"Profil → „Hilfe & FAQ\\\" → „Support kontaktieren\\\". Oder in jeder Anfrage — Chat-Symbol neben dem Status. Support antwortet auf Deutsch, Englisch und Russisch.\",\n          \"q\": \"Wo finde ich den Support-Chat?\"\n        }\n      }\n    },\n    \"cta_contact\": \"Support kontaktieren\",\n    \"cta_sub\": \"Support kontaktieren\",\n    \"cta_title\": \"Antwort nicht gefunden?\",\n    \"intro\": \"Auto Search ist eine Plattform für Fahrzeugsuche und Kaufprüfung. Hier finden Sie Antworten auf die häufigsten Fragen.\",\n    \"title\": \"Hilfe & FAQ\"\n  },\n  \"home\": {\n    \"additional_open\": \"Alle Dienste →\",\n    \"additional_section\": \"Weitere Dienste\",\n    \"additional_section_sub\": \"Reparatur, Waschen, Überführung, Abschleppdienst und mehr\",\n    \"bookings_quick\": \"Termine\",\n    \"choose_service\": \"Alle Dienste\",\n    \"clusters\": {\n      \"delivery_sub\": \"EU-Import Haustür\",\n      \"delivery_title\": \"Lieferung\",\n      \"inspection_sub\": \"Vor dem Kauf, TÜV-Stil\",\n      \"inspection_title\": \"Inspektion\",\n      \"repair_sub\": \"Diagnose, Abschlepp, vor Ort\",\n      \"repair_title\": \"Reparatur / Hilfe\",\n      \"selection_sub\": \"Das richtige Auto finden\",\n      \"selection_title\": \"Auswahl\"\n    },\n    \"continue_as_guest\": \"Als Gast fortfahren\",\n    \"cta_inspect_sub\": \"Vollständiger TÜV-Bericht · 60 Punkte · €149\",\n    \"cta_inspect_title\": \"Auto vor dem Kauf prüfen\",\n    \"cta_select_sub\": \"Wir finden 3–5 geprüfte Optionen passend zu Ihren Wünschen\",\n    \"cta_select_title\": \"Auto nach Budget auswählen\",\n    \"empty_sub\": \"Erstellen Sie Ihre erste Anfrage — Bericht in 24 Stunden\",\n    \"empty_title\": \"Noch keine Anfragen\",\n    \"find_shop\": \"Werkstatt finden\",\n    \"greeting\": \"Guten Tag\",\n    \"greeting_afternoon\": \"Guten Tag\",\n    \"greeting_day\": \"Guten Tag\",\n    \"greeting_evening\": \"Guten Abend\",\n    \"greeting_morning\": \"Guten Morgen\",\n    \"guest\": \"Gast\",\n    \"hero_sub\": \"Wir prüfen das Auto vor dem Kauf — Bericht in 24 Stunden\",\n    \"hero