{"dependencies":[],"output":[{"data":{"code":"__d(function(global, require, _importDefaultUnused, _importAllUnused, module, exports, _dependencyMapUnused) {\n  module.exports = {\n  \"_doc\": \"Customer-Deep-Link-1 — grammar-owned semantic destination map. Lives next to copy/{en,de,ru}.json so the grammar kernel owns BOTH narrative and routing. Transports (push/email/sms/in-app) resolve a (surface, params) tuple to their own concrete URL — they do NOT make semantic destination decisions. Locale-invariant by design: there is no per-language deep-link map.\",\n\n  \"_invariants\": \"1) Every key in EVENT_TO_SURFACE must be on the customer notification allowlist (Customer-Notify-1 NotificationKey). 2) Surface value must be in SURFACES list. 3) Route templates must reference only declared params. 4) Forbidden-route eventTypes (ocr.*/correlation.*/evidence.*/internal.*/suspicion.*) NEVER appear here. 5) routes.mobile and routes.web MUST both be present for every surface — channel isolation is for tone, not for destination.\",\n\n  \"surfaces\": [\"continuity\", \"timeline\", \"report-cognition\"],\n\n  \"event_to_surface\": {\n    \"inspection.started\":    \"continuity\",\n    \"report.submitted\":      \"report-cognition\",\n    \"item.flagged_critical\": \"timeline\",\n    \"item.flagged_warning\":  \"timeline\"\n  },\n\n  \"params_required\": {\n    \"continuity\":       [\"jobId\"],\n    \"timeline\":         [\"jobId\"],\n    \"report-cognition\": [\"jobId\"]\n  },\n\n  \"params_optional\": {\n    \"continuity\":       [],\n    \"timeline\":         [\"itemId\"],\n    \"report-cognition\": []\n  },\n\n  \"_route_template_doc\": \"Tokens in {curly braces} are bound from `params`. Templates with optional params append `?focus={itemId}` only when itemId is bound. mobile = Expo Router path. web = Vite SPA path on the customer web surface. Email CTAs reuse the web route. SMS does not carry URLs in Notify-1/2/3 — sms transport ignores routes by design.\",\n\n  \"routes\": {\n    \"continuity\": {\n      \"mobile\": \"/customer/inspection/{jobId}/continuity\",\n      \"web\":    \"/customer/inspection/{jobId}/continuity\"\n    },\n    \"timeline\": {\n      \"mobile\": \"/customer/inspection/{jobId}/timeline\",\n      \"web\":    \"/customer/inspection/{jobId}/timeline\"\n    },\n    \"report-cognition\": {\n      \"mobile\": \"/customer/inspection/{jobId}/cognition\",\n      \"web\":    \"/customer/inspection/{jobId}/cognition\"\n    }\n  },\n\n  \"_focus_token\": \"When `itemId` is bound for a timeline destination, append `?focus={itemId}` to both mobile and web routes. Other surfaces ignore itemId.\"\n}\n;\n});","lineCount":48,"map":[[48,3]],"functionMap":null},"type":"js/module"}]}